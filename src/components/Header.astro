---
import { nav, site } from "../data/site";
import { href } from "../lib/url";
import logo from "../assets/logo/logo-kompakt.svg?raw";

// Logo inline, damit es scharf bleibt und ohne eigene Anfrage lädt; der Linktext kommt aus aria-label
const logoSvg = logo.replace("<svg ", '<svg aria-hidden="true" focusable="false" ');

const current = Astro.url.pathname.replace(/\/$/, "");
const isActive = (path: string) => current === href(path).replace(/\/$/, "");
---
<header class="kopf">
  <div class="wrap zeile">
    <a class="marke" href={href()} aria-label={`${site.name}, Startseite`}>
      <Fragment set:html={logoSvg} />
    </a>
    <nav aria-label="Hauptmenü">
      <ul>
        {nav.map((item) => (
          <li><a href={href(item.href)} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <a class="knopf klein" href={href("anfrage")}>Plan anfragen</a>
  </div>
</header>

<style>
  .kopf {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--creme) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--linie);
  }

  .zeile {
    display: flex;
    align-items: center;
    gap: 28px;
    min-height: 74px;
  }

  .marke {
    display: flex;
    margin-right: auto;
  }

  .marke :global(svg) {
    display: block;
    height: 58px;
    width: auto;
  }

  ul {
    display: flex;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    display: block;
    padding: 8px 12px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 550;
  }

  nav a:hover {
    background: var(--creme-dunkel);
  }

  nav a[aria-current="page"] {
    box-shadow: inset 0 -3px 0 var(--nuss);
    border-radius: 0;
  }

  .klein {
    padding: 0.6em 1em;
    font-size: 0.98rem;
  }

  @media (max-width: 760px) {
    .zeile {
      flex-wrap: wrap;
      gap: 0 12px;
      padding-block: 10px;
    }

    .marke :global(svg) {
      height: 34px;
    }

    nav {
      order: 3;
      width: 100%;
      overflow-x: auto;
    }

    nav a {
      padding: 8px 10px 8px 0;
      margin-right: 10px;
      white-space: nowrap;
    }
  }
</style>
