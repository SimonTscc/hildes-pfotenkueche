---
import { nav, site } from "../data/site";
import { href } from "../lib/url";
import logo from "../assets/logo/logo-kompakt.svg?raw";

// Logo inline, damit es scharf bleibt und ohne eigene Anfrage lädt; der Linktext kommt aus aria-label
const logoSvg = logo.replace("<svg ", '<svg aria-hidden="true" focusable="false" ');

const current = Astro.url.pathname.replace(/\/$/, "");
const isActive = (path: string) => current === href(path).replace(/\/$/, "");
---
<header class="kopf">
  <div class="wrap zeile">
    <a class="marke" href={href()} aria-label={`${site.name}, Startseite`}>
      <Fragment set:html={logoSvg} />
    </a>
    <nav aria-label="Hauptmenü">
      <ul>
        {nav.map((item) => (
          <li><a href={href(item.href)} aria-current={isActive(item.href) ? "page" : undefined}>
            {item.kurz ? <><span class="lang">{item.label}</span><span class="kurz" aria-hidden="true">{item.kurz}</span></> : item.label}
          </a></li>
        ))}
      </ul>
    </nav>
    <!-- Warenkorb außerhalb der Menüliste: auf dem Handy wischt die Liste seitlich, der Korb bleibt stehen -->
    <a class="korb" href={href("warenkorb")} aria-current={isActive("warenkorb") ? "page" : undefined}>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 5h2.2l2.1 10.2a1.5 1.5 0 0 0 1.5 1.2h8.6a1.5 1.5 0 0 0 1.5-1.1L21 8H6.2" /><circle cx="9.5" cy="20" r="1.3" /><circle cx="17" cy="20" r="1.3" /></svg>
      <span>Warenkorb</span>
      <b class="zahl" data-korb-zahl hidden></b>
    </a>
    <a class="knopf klein" href={href("anfrage")}>Plan anfragen</a>
  </div>
</header>

<script>
  import { anzahlGesamt, beobachten } from "../lib/warenkorb";
  const zahl = document.querySelector<HTMLElement>("[data-korb-zahl]");
  const link = zahl?.closest("a");
  if (zahl && link) {
    beobachten(() => {
      const n = anzahlGesamt();
      zahl.hidden = n === 0;
      zahl.textContent = String(n);
      link.setAttribute("aria-label", n ? `Warenkorb, ${n} Artikel` : "Warenkorb, leer");
    });
  }
</script>

<style>
  .kopf {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--creme) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--linie);
  }

  .zeile {
    display: flex;
    align-items: center;
    gap: 28px;
    min-height: 74px;
  }

  .marke {
    display: flex;
    margin-right: auto;
  }

  .marke :global(svg) {
    display: block;
    height: 49px;
    width: auto;
  }

  ul {
    display: flex;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    display: block;
    padding: 8px 12px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 550;
  }

  nav a:hover {
    background: var(--creme-dunkel);
  }

  nav a[aria-current="page"] {
    box-shadow: inset 0 -3px 0 var(--nuss);
    border-radius: 0;
  }

  .klein {
    padding: 0.6em 1em;
    font-size: 0.98rem;
  }

  .korb {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 6px;
    text-decoration: none;
    font-weight: 550;
    border-radius: 6px;
  }

  .korb:hover {
    background: var(--creme-dunkel);
  }

  .korb[aria-current="page"] {
    box-shadow: inset 0 -3px 0 var(--nuss);
    border-radius: 0;
  }

  .korb svg {
    width: 21px;
    height: 21px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .korb circle {
    fill: currentColor;
    stroke: none;
  }

  /* Das Symbol reicht, der Text bleibt für Screenreader */
  .korb span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
  }

  /* Kurzname nur im Handy-Menü */
  .kurz {
    display: none;
  }

  @media (max-width: 760px) {
    .kurz {
      display: inline;
    }
  }

  .zahl {
    min-width: 1.45em;
    height: 1.45em;
    padding: 0 0.35em;
    border-radius: 99px;
    background: var(--nuss-tief);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.45em;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 760px) {
    .zeile {
      flex-wrap: wrap;
      gap: 0 12px;
      padding-block: 10px;
    }

    .marke :global(svg) {
      height: 26px;
    }

    /* Zweite Zeile: wischbares Menü, rechts daneben fest der Warenkorb.
       Der weiche Rand rechts zeigt, dass man weiterwischen kann. */
    nav {
      order: 3;
      flex: 1 1 calc(100% - 76px);
      min-width: 0;
      overflow-x: auto;
      scrollbar-width: none;
      mask-image: linear-gradient(to right, #000 calc(100% - 28px), transparent);
    }

    nav .lang {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .korb {
      order: 4;
      flex: none;
    }

    nav a {
      padding: 8px 0;
      margin-right: 16px;
      font-size: 16px;
      white-space: nowrap;
    }
  }
</style>
