---
// Hildes eigene Fotos. Liegt die Datei in src/assets/bilder/hilde/ (z. B. hilde.jpg, hunde.jpg,
// katzen.jpg; auch .jpeg, .png oder .webp), wird sie gezeigt, sonst ein Platzhalter „Foto folgt“.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Pfote from "./Pfote.astro";

interface Props {
  name: string; // Dateiname ohne Endung
  alt: string;
  platzhalter: string; // was später auf dem Foto sein soll
  format?: string; // CSS aspect-ratio
  sizes?: string;
  eager?: boolean;
  ausschnitt?: string; // object-position, z. B. "50% 30%"
}
const { name, alt, platzhalter, format = "3 / 2", sizes = "(max-width: 900px) 92vw, 520px", eager = false, ausschnitt = "50% 50%" } = Astro.props;

const dateien = import.meta.glob<{ default: ImageMetadata }>("../assets/bilder/hilde/*.{jpg,jpeg,png,webp}", { eager: true });
const treffer = Object.entries(dateien).find(([pfad]) => pfad.split("/").pop()!.replace(/\.[^.]+$/, "").toLowerCase() === name);
const bild = treffer?.[1].default;
---
{bild ? (
  <Image class="eigenes-foto" src={bild} alt={alt} widths={[480, 800, 1200]} sizes={sizes} loading={eager ? "eager" : "lazy"} style={`aspect-ratio: ${format}; object-position: ${ausschnitt}`} />
) : (
  <div class="eigenes-foto platz" style={`aspect-ratio: ${format}`} role="img" aria-label={`Foto folgt: ${platzhalter}`}>
    <Pfote size={30} />
    <span>Foto folgt</span>
    <small>{platzhalter}</small>
  </div>
)}

<style>
  .eigenes-foto {
    width: 100%;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--schatten);
  }

  .platz {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 6px;
    padding: 20px;
    text-align: center;
    color: var(--tanne-hell);
    background:
      repeating-linear-gradient(135deg, transparent 0 14px, rgba(139, 107, 85, 0.07) 14px 28px),
      var(--blatt);
    border: 2px dashed var(--creme-dunkel);
    box-shadow: none;
  }

  .platz :global(svg) {
    color: var(--nuss);
  }

  .platz span {
    font-family: var(--kopf);
    font-size: 1.3rem;
    color: var(--tanne);
  }

  .platz small {
    font-size: 0.92rem;
    max-width: 26ch;
  }
</style>
