---
// Napf-Rechner: Tagesration nach gängigen BARF-Faustregeln, angezeigt auf einer Küchenwaage.
import { href } from "../lib/url";

const teile = [
  { key: "muskel", name: "Muskelfleisch", farbe: "var(--fleisch)", anteil: 0.4 },
  { key: "pansen", name: "Pansen & Blättermagen", farbe: "#b3a685", anteil: 0.16 },
  { key: "innereien", name: "Innereien", farbe: "#5e2420", anteil: 0.12 },
  { key: "knochen", name: "Fleischige Knochen", farbe: "var(--knochen)", anteil: 0.12 },
  { key: "gemuese", name: "Gemüse", farbe: "var(--gruen)", anteil: 0.15 },
  { key: "obst", name: "Obst", farbe: "var(--kuerbis)", anteil: 0.05 },
];
const ticks = Array.from({ length: 41 }, (_, i) => i);
---
<div class="rechner" data-rechner data-anfrage={href("anfrage")}>
  <form class="eingabe" aria-label="Angaben zu deinem Hund">
    <div class="feld">
      <label for="gewicht">Wie viel wiegt dein Hund?</label>
      <div class="gewicht">
        <button type="button" data-schritt="-1" aria-label="Ein Kilo weniger">−</button>
        <output id="gewicht-anzeige" for="gewicht"><span data-gewicht>18</span> kg</output>
        <button type="button" data-schritt="1" aria-label="Ein Kilo mehr">+</button>
      </div>
      <input id="gewicht" name="gewicht" type="range" min="2" max="70" step="1" value="18" />
    </div>

    <fieldset class="feld">
      <legend>Lebensphase</legend>
      <div class="wahl">
        <label><input type="radio" name="phase" value="welpe" /> <span>Welpe</span></label>
        <label><input type="radio" name="phase" value="adult" checked /> <span>Erwachsen</span></label>
        <label><input type="radio" name="phase" value="senior" /> <span>Senior</span></label>
      </div>
    </fieldset>

    <fieldset class="feld">
      <legend>Wie aktiv ist er?</legend>
      <div class="wahl">
        <label><input type="radio" name="aktiv" value="ruhig" /> <span>Gemütlich</span></label>
        <label><input type="radio" name="aktiv" value="normal" checked /> <span>Normal</span></label>
        <label><input type="radio" name="aktiv" value="sport" /> <span>Sehr aktiv</span></label>
      </div>
    </fieldset>

    <label class="haken">
      <input type="checkbox" name="abnehmen" />
      <span>Soll abnehmen</span>
    </label>
  </form>

  <div class="ergebnis" aria-live="polite">
    <div class="waage">
      <svg viewBox="0 0 240 240" class="skala" aria-hidden="true">
        <circle cx="120" cy="120" r="112" class="rand" />
        <circle cx="120" cy="120" r="100" class="blatt" />
        {ticks.map((i) => {
          const a = ((-135 + (i * 270) / 40) * Math.PI) / 180;
          const lang = i % 10 === 0;
          const r1 = lang ? 80 : 88;
          return (
            <line
              x1={120 + Math.sin(a) * r1}
              y1={120 - Math.cos(a) * r1}
              x2={120 + Math.sin(a) * 96}
              y2={120 - Math.cos(a) * 96}
              class={lang ? "lang" : "kurz"}
            />
          );
        })}
        {[0, 1, 2, 3, 4].map((i) => {
          const a = ((-135 + i * 67.5) * Math.PI) / 180;
          return <text x={120 + Math.sin(a) * 64} y={124 - Math.cos(a) * 64} data-zahl={i}>{i * 250}</text>;
        })}
        <text x="120" y="176" class="einheit">Gramm</text>
        <g class="zeiger" data-zeiger>
          <path d="M120 34 L124.5 120 L115.5 120 Z" />
          <rect x="117.5" y="118" width="5" height="22" rx="2" />
        </g>
        <circle cx="120" cy="120" r="9" class="mitte" />
      </svg>
    </div>

    <div class="summe">
      <p class="klein">Tagesration ungefähr</p>
      <p class="gramm"><span data-summe>450</span> g</p>
      <p class="woche">pro Woche rund <span data-woche>3,2</span> kg · <span data-prozent>2,5</span> % des Körpergewichts</p>
    </div>

    <div class="napf" role="img" aria-label="Aufteilung der Tagesration">
      {teile.map((t) => <span data-balken={t.key} style={`background:${t.farbe};flex-grow:${t.anteil}`}></span>)}
    </div>
    <ul class="teile">
      {teile.map((t) => (
        <li data-teil={t.key} data-anteil={t.anteil}>
          <span class="punkt" style={`background:${t.farbe}`}></span>
          <span>{t.name}</span>
          <span class="wert"><span data-wert>0</span> g</span>
        </li>
      ))}
    </ul>
    <p class="hinweis" data-hinweis>
      Ein Richtwert nach den üblichen BARF-Faustregeln. Ein echter Plan rechnet zusätzlich Nährstoffe, Kalzium,
      Öle und die Vorlieben deines Hundes mit ein.
    </p>
    <a class="knopf" data-link href={href("anfrage")}>Mit diesen Werten Plan anfragen</a>
  </div>
</div>

<script>
  // Faustregeln: Tagesration in % des Körpergewichts, Verteilung 80 % tierisch / 20 % pflanzlich
  const PROZENT = { ruhig: 2, normal: 2.5, sport: 3 } as const;
  const SKALEN = [500, 1000, 1500, 2000, 3000];

  for (const root of document.querySelectorAll<HTMLElement>("[data-rechner]")) {
    const form = root.querySelector("form")!;
    const range = form.querySelector<HTMLInputElement>("#gewicht")!;
    const zeiger = root.querySelector<SVGGElement>("[data-zeiger]")!;
    const zahlen = root.querySelectorAll<SVGTextElement>("[data-zahl]");
    const link = root.querySelector<HTMLAnchorElement>("[data-link]")!;
    const hinweis = root.querySelector<HTMLElement>("[data-hinweis]")!;
    const hinweisText = hinweis.textContent ?? "";
    const fmt = (n: number, d = 0) => n.toLocaleString("de-DE", { minimumFractionDigits: d, maximumFractionDigits: d });
    let skala = 0;

    const rechnen = () => {
      const data = new FormData(form);
      const kg = Number(range.value);
      const phase = String(data.get("phase"));
      const aktiv = String(data.get("aktiv")) as keyof typeof PROZENT;
      const abnehmen = data.get("abnehmen") === "on";

      let prozent: number = PROZENT[aktiv];
      if (phase === "senior") prozent = Math.max(2, prozent - 0.25);
      if (phase === "welpe") prozent = 5;
      if (abnehmen && phase !== "welpe") prozent = Math.max(1.5, prozent - 0.5);

      const summe = Math.round((kg * 1000 * prozent) / 100 / 5) * 5;
      root.querySelector("[data-gewicht]")!.textContent = String(kg);
      root.querySelector("[data-summe]")!.textContent = fmt(summe);
      root.querySelector("[data-woche]")!.textContent = fmt((summe * 7) / 1000, 1);
      root.querySelector("[data-prozent]")!.textContent = fmt(prozent, prozent % 1 ? 1 : 0);

      for (const li of root.querySelectorAll<HTMLElement>("[data-teil]")) {
        const g = Math.round((summe * Number(li.dataset.anteil)) / 5) * 5;
        li.querySelector("[data-wert]")!.textContent = fmt(g);
      }

      // Skala der Waage passend wählen, Zahlen neu beschriften
      const neu = SKALEN.find((s) => s >= summe * 1.12) ?? SKALEN[SKALEN.length - 1];
      if (neu !== skala) {
        skala = neu;
        zahlen.forEach((t, i) => (t.textContent = fmt((skala / 4) * i)));
      }
      const winkel = -135 + (Math.min(summe, skala) / skala) * 270;
      zeiger.style.transform = `rotate(${winkel}deg)`;

      hinweis.textContent =
        phase === "welpe"
          ? "Bei Welpen ist das nur ein grober Startwert: Der Bedarf ändert sich mit jeder Wachstumsphase. Hier unbedingt mit Plan füttern."
          : hinweisText;

      const q = new URLSearchParams({ gewicht: String(kg), phase, aktiv, ...(abnehmen ? { abnehmen: "ja" } : {}) });
      link.href = `${root.dataset.anfrage}?${q}`;
    };

    form.addEventListener("input", rechnen);
    for (const btn of root.querySelectorAll<HTMLButtonElement>("[data-schritt]")) {
      btn.addEventListener("click", () => {
        range.value = String(Number(range.value) + Number(btn.dataset.schritt));
        rechnen();
      });
    }
    rechnen();
  }
</script>

<style>
  .rechner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    background: var(--blatt);
    border-radius: 18px;
    box-shadow: var(--schatten);
    overflow: hidden;
  }

  .eingabe {
    padding: clamp(22px, 3vw, 36px);
    display: grid;
    gap: 26px;
    align-content: start;
    border-right: 1px dashed var(--linie);
  }

  .feld {
    border: 0;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  label,
  legend {
    font-weight: 600;
  }

  legend {
    padding: 0;
    margin-bottom: 10px;
  }

  .gewicht {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .gewicht output {
    font-family: var(--kopf);
    font-size: 2.6rem;
    font-weight: 800;
    line-height: 1;
    min-width: 4.2ch;
    text-align: center;
    color: var(--tanne);
  }

  .gewicht button {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 2px solid var(--tanne);
    background: transparent;
    color: var(--tanne);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }

  .gewicht button:hover {
    background: var(--tanne);
    color: var(--blatt);
  }

  input[type="range"] {
    width: 100%;
    accent-color: var(--moehre);
    height: 28px;
  }

  .wahl {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 2px solid var(--tanne);
    border-radius: 8px;
    overflow: hidden;
  }

  .wahl label {
    position: relative;
    font-weight: 550;
  }

  .wahl input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }

  .wahl span {
    display: block;
    padding: 9px 6px;
    text-align: center;
    font-size: 0.95rem;
  }

  .wahl label + label span {
    border-left: 2px solid var(--tanne);
  }

  .wahl input:checked + span {
    background: var(--tanne);
    color: var(--blatt);
  }

  .wahl input:focus-visible + span {
    outline: 3px solid var(--moehre);
    outline-offset: -3px;
  }

  .haken {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
  }

  .haken input {
    width: 20px;
    height: 20px;
    accent-color: var(--moehre);
  }

  .ergebnis {
    padding: clamp(22px, 3vw, 36px);
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 18px 26px;
    align-content: start;
    background: linear-gradient(160deg, #fff 0%, var(--blatt) 70%);
  }

  .waage {
    grid-row: span 2;
  }

  .skala {
    width: 100%;
    height: auto;
  }

  .rand {
    fill: var(--tanne);
  }

  .blatt {
    fill: #fbfaf5;
  }

  .lang,
  .kurz {
    stroke: var(--tanne);
    stroke-linecap: round;
  }

  .lang {
    stroke-width: 2.5;
  }

  .kurz {
    stroke-width: 1;
    opacity: 0.55;
  }

  .skala text {
    font-family: var(--kopf);
    font-size: 13px;
    font-weight: 650;
    fill: var(--tanne);
    text-anchor: middle;
  }

  .skala .einheit {
    font-size: 11px;
    font-weight: 500;
    opacity: 0.6;
  }

  .zeiger {
    fill: var(--moehre);
    transform-origin: 120px 120px;
    transform: rotate(-135deg);
    transition: transform 0.7s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .mitte {
    fill: var(--tanne);
  }

  .summe {
    align-self: center;
  }

  .klein {
    font-weight: 600;
    color: var(--tanne-hell);
  }

  .gramm {
    font-family: var(--kopf);
    font-size: clamp(2.8rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1;
    color: var(--tanne);
  }

  .woche {
    font-size: 0.95rem;
    color: var(--tanne-hell);
  }

  .napf {
    display: flex;
    height: 22px;
    border-radius: 6px;
    overflow: hidden;
    gap: 2px;
    align-self: end;
  }

  .teile {
    grid-column: 1 / -1;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 24px;
  }

  .teile li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 0;
    border-bottom: 1px solid var(--linie);
  }

  .punkt {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    flex: none;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.12);
  }

  .wert {
    margin-left: auto;
    font-family: var(--kopf);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .hinweis {
    grid-column: 1 / -1;
    font-size: 0.92rem;
    color: var(--tanne-hell);
  }

  .ergebnis .knopf {
    grid-column: 1 / -1;
    justify-self: start;
  }

  @media (max-width: 900px) {
    .rechner {
      grid-template-columns: 1fr;
    }

    .eingabe {
      border-right: 0;
      border-bottom: 1px dashed var(--linie);
    }
  }

  @media (max-width: 520px) {
    .ergebnis {
      grid-template-columns: 1fr;
    }

    .waage {
      grid-row: auto;
      width: 200px;
      justify-self: center;
    }

    .summe {
      text-align: center;
    }

    .teile {
      grid-template-columns: 1fr;
    }
  }
</style>
