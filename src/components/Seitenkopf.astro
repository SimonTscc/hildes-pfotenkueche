---
// Kopf einer Unterseite: Titel und Einleitung links, optional ein Foto rechts.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  titel: string;
  bild?: ImageMetadata;
  alt?: string;
}
const { titel, bild, alt = "" } = Astro.props;
---
<header class="seitenkopf">
  <div class="wrap raster">
    <div>
      <h1>{titel}</h1>
      <div class="einleitung"><slot /></div>
    </div>
    {bild && <Image src={bild} alt={alt} widths={[480, 800, 1200]} sizes="(max-width: 900px) 92vw, 520px" loading="eager" />}
  </div>
</header>

<style>
  .seitenkopf {
    padding: clamp(40px, 6vw, 84px) 0 clamp(40px, 6vw, 72px);
    border-bottom: 1px solid var(--linie);
  }

  .raster {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: end;
  }

  h1 {
    font-size: clamp(2.4rem, 5.6vw, 4.4rem);
    margin-bottom: 20px;
  }

  .einleitung {
    font-size: 1.18rem;
    max-width: 50ch;
    display: grid;
    gap: 12px;
  }

  .raster > :global(img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--schatten);
  }

  @media (max-width: 900px) {
    .raster {
      grid-template-columns: 1fr;
    }
  }
</style>
