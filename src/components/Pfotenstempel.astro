---
// Pfotenabdruck beim Klicken auf leere Flächen. Links, Knöpfe, Formulare und das Napf-Spiel bleiben frei.
---
<script>
  const farben = ["var(--nuss)", "var(--tanne)", "var(--tanne-hell)", "var(--nuss-tief)"];
  const frei = "a, button, input, select, textarea, label, summary, [data-spiel], [data-ohne-pfote]";
  const pfote = (farbe: string) =>
    `<svg viewBox="0 0 24 24" aria-hidden="true" style="fill:${farbe}">` +
    `<path d="M12 12.4c-2.7 0-5.6 3.1-5.6 5.6 0 1.7 1.3 2.6 2.8 2.6 1.1 0 1.8-.5 2.8-.5s1.7.5 2.8.5c1.5 0 2.8-.9 2.8-2.6 0-2.5-2.9-5.6-5.6-5.6z"/>` +
    `<ellipse cx="4.6" cy="10.2" rx="2" ry="2.5" transform="rotate(-20 4.6 10.2)"/>` +
    `<ellipse cx="8.9" cy="5.6" rx="2.1" ry="2.7" transform="rotate(-8 8.9 5.6)"/>` +
    `<ellipse cx="15.1" cy="5.6" rx="2.1" ry="2.7" transform="rotate(8 15.1 5.6)"/>` +
    `<ellipse cx="19.4" cy="10.2" rx="2" ry="2.5" transform="rotate(20 19.4 10.2)"/></svg>`;

  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest(frei)) return;
      // Text markieren soll keine Pfote setzen
      if (String(getSelection() ?? "").length) return;
      const el = document.createElement("div");
      el.className = "pfotenstempel";
      el.style.left = e.clientX + "px";
      el.style.top = e.clientY + "px";
      el.style.setProperty("--dreh", Math.round(Math.random() * 50 - 25) + "deg");
      el.innerHTML = pfote(farben[Math.floor(Math.random() * farben.length)]);
      document.body.appendChild(el);
      setTimeout(() => el.remove(), 1300);
    });
  }
</script>

<style is:global>
  .pfotenstempel {
    position: fixed;
    z-index: 90;
    width: 46px;
    height: 46px;
    pointer-events: none;
    translate: -50% -50%;
    rotate: var(--dreh);
    animation: pfotenstempel 1.2s cubic-bezier(0.2, 0.8, 0.3, 1) forwards;
  }

  .pfotenstempel svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Pfote drückt auf, bleibt kurz und verblasst */
  @keyframes pfotenstempel {
    0% {
      scale: 1.5;
      opacity: 0;
    }
    18% {
      scale: 0.92;
      opacity: 0.9;
    }
    28% {
      scale: 1;
    }
    65% {
      opacity: 0.85;
    }
    100% {
      scale: 1;
      opacity: 0;
    }
  }
</style>
