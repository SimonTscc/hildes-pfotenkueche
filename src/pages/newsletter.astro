---
import Base from "../layouts/Base.astro";
import NewsletterAnmeldung from "../components/NewsletterAnmeldung.astro";
import { newsletter } from "../data/newsletter";
---
<Base title="Newsletter" description="Mein Newsletter: neue Webinar-Termine zuerst, Tipps für den BARF-Alltag mit Hund und Katze und kleine Aktionen.">
  <div class="wrap seite">
    <div class="text">
      <p class="dachzeile">{newsletter.dachzeile}</p>
      <h1>{newsletter.titel}</h1>
      <p class="einleitung">{newsletter.einleitung}</p>
      <ol class="vorteile">
        {newsletter.vorteile.map((v) => (
          <li>
            <h2>{v.titel}</h2>
            <p>{v.text}</p>
          </li>
        ))}
      </ol>
      <p class="leise">{newsletter.versprechen}</p>
    </div>
    <div class="karte">
      <NewsletterAnmeldung quelle="Newsletter-Seite" />
    </div>
  </div>
</Base>

<style>
  .seite {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    gap: clamp(28px, 5vw, 80px);
    padding-block: clamp(40px, 6vw, 88px);
    align-items: start;
  }

  .dachzeile {
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--nuss-dunkel);
    margin-bottom: 10px;
  }

  h1 {
    font-size: clamp(2.4rem, 5vw, 4rem);
    margin-bottom: 18px;
  }

  .einleitung {
    font-size: 1.15rem;
    max-width: 50ch;
  }

  .vorteile {
    list-style: none;
    margin: 32px 0 24px;
    padding: 0;
    counter-reset: v;
    border-top: 1px solid var(--linie);
  }

  .vorteile li {
    counter-increment: v;
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    gap: 2px 8px;
    padding: 16px 0;
    border-bottom: 1px solid var(--linie);
  }

  .vorteile li::before {
    content: counter(v);
    grid-row: span 2;
    font-family: var(--kopf);
    font-size: 1.6rem;
    line-height: 1.1;
    color: var(--nuss);
  }

  .vorteile h2 {
    font-size: 1.25rem;
  }

  .vorteile p {
    max-width: 46ch;
  }

  .leise {
    color: var(--tanne-hell);
  }

  .karte {
    background: var(--blatt);
    border-radius: 14px;
    padding: clamp(22px, 3.5vw, 40px);
    box-shadow: var(--schatten);
    position: sticky;
    top: 110px;
  }

  @media (max-width: 860px) {
    .seite {
      grid-template-columns: 1fr;
    }

    .karte {
      position: static;
    }
  }
</style>
