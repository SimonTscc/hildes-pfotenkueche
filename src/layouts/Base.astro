---
import { getImage } from "astro:assets";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { isPreview, site } from "../data/site";
import vorschau from "../assets/bilder/rohfutter-napf.jpg";
import bricolage from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url";
import onest from "@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url";

interface Props {
  title?: string;
  description: string;
  /** false für Seiten ohne eigene Hauptadresse (404) */
  kanonisch?: boolean;
}
const { title, description, kanonisch = true } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.claim}`;
const url = new URL(Astro.url.pathname, Astro.site);

// Vorschaubild beim Teilen (WhatsApp, Instagram, Facebook) im üblichen Format 1200 × 630
const teilbild = await getImage({ src: vorschau, width: 1200, height: 630, fit: "cover", format: "jpg", quality: 80 });
const teilbildUrl = new URL(teilbild.src, Astro.site);
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6efe6" />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`} type="image/svg+xml" />
    {kanonisch && <link rel="canonical" href={url} />}
    <link rel="preload" href={bricolage} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={onest} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={teilbildUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Hund frisst rohes BARF aus einem mintgrünen Napf" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <a class="sprunglink" href="#inhalt">Zum Inhalt springen</a>
    <Header />
    <main id="inhalt">
      <slot />
    </main>
    <Footer />
  </body>
</html>
